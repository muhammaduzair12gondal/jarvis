# CIPHER Backend — Environment Variables
# Copy this file to .env and fill in your keys.

# Memory backend: "json" (local file) or "postgres" (cloud DB)
CIPHER_MEMORY_BACKEND=json
# CIPHER_MEMORY_DATABASE_URL=postgresql://user:password@host:5432/dbname
# CIPHER_DB_SSLMODE=require

# LLM Provider Keys (at least one required)
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
MISTRAL_API_KEY=your_mistral_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
TOGETHER_API_KEY=your_together_key_here
